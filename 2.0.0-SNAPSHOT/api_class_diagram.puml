@startuml
title
    <img:../assets/logo.svg{scale=0.2}>

    Terminal Storage Card API - 2.0.+ (2026-06-15)
end title

' == THEME ==

'Couleurs issues de : https://htmlcolorcodes.com/fr/tableau-de-couleur/tableau-de-couleur-design-plat/
!define C_GREY1 F8F9F9
!define C_GREY2 F2F3F4
!define C_GREY3 E5E7E9
!define C_GREY4 D7DBDD
!define C_GREY5 CACFD2
!define C_GREY6 BDC3C7
!define C_LINK 3498DB
!define C_USE 27AE60

skinparam ClassBorderThickness 2
skinparam ArrowThickness 2

' Yellow
skinparam ClassBackgroundColor #FEFECE
skinparam ClassBorderColor #D4AC0D
' Red
skinparam ClassBackgroundColor<<red>> #FDEDEC
skinparam ClassBorderColor<<red>> #E74C3C
hide <<red>> stereotype
' Purple
skinparam ClassBackgroundColor<<purple>> #F4ECF7
skinparam ClassBorderColor<<purple>> #8E44AD
hide <<purple>> stereotype
' blue
skinparam ClassBackgroundColor<<blue>> #EBF5FB
skinparam ClassBorderColor<<blue>> #3498DB
hide <<blue>> stereotype
' Green
skinparam ClassBackgroundColor<<green>> #E9F7EF
skinparam ClassBorderColor<<green>> #27AE60
hide <<green>> stereotype
' Grey
skinparam ClassBackgroundColor<<grey>> #EAECEE
skinparam ClassBorderColor<<grey>> #2C3E50
hide <<grey>> stereotype

' == CONTENT ==

legend top
    * __External public API references__
    *** <back:yellow>**Calypsonet Terminal Reader API**</back>
    * __Text__
    *** <color:blue><b>New element added since the last version
    *** <color:red><s><b>Element marked as deprecated since the last version
    *** <s><b>Element marked as deprecated
    *** <color:grey><b>Work in progress...
    * __Object__
    *** <back:#EBF5FB><color:#3498DB><b>Factory or interface provided by the factory
    *** <back:#FEFECE><color:#D4AC0D><b>Interface that cannot be instantiated directly by the factory
    *** <back:#FDEDEC><color:#E74C3C><b>SPI (Service Provider Interface) to be provided by the end-user
    *** <back:#E9F7EF><color:#27AE60><b>Class, enum or exception
end legend

package "terminal.storagecard" as root {
    +class "**final** StorageCardApiProperties" as ApiProperties <<green>> {
        +{static} **final** String VERSION
    }
    +interface "StorageCardApiFactory" as StorageCardApiFactory <<blue>> {
        +StorageCardSelectionExtension createStorageCardSelectionExtension (ProductType productType)

        +StorageCardTransactionManager createStorageCardTransactionManager (<back:yellow>CardReader reader</back>, StorageCard card)
    }

    package "card" as card {
        +interface "<<<back:yellow>CardSelectionExtension</back>>>\nStorageCardSelectionExtension" as StorageCardSelectionExtension <<blue>> {
            +StorageCardSelectionExtension prepareReadBlock (int blockAddress)
            +StorageCardSelectionExtension prepareReadBlocks (int fromBlockAddress, int toBlockAddress)
            .. **ST25 / SRT512** ..
            +StorageCardSelectionExtension prepareSt25ReadSystemBlock ()
            .. **Mifare Classic** ..
            +StorageCardSelectionExtension prepareMifareClassicAuthenticate (int blockAddress, MifareClassicKeyType mifareClassicKeyType, byte[] key)
            +StorageCardSelectionExtension prepareMifareClassicAuthenticate (int blockAddress, MifareClassicKeyType mifareClassicKeyType, int keyNumber)
        }
        +interface "<<<back:yellow>SmartCard</back>>>\nStorageCard" as StorageCard {
            +ProductType getProductType ()
            +byte[] getUID ()
            +byte[] getBlock (int blockAddress)
            +byte[] getBlocks (int fromBlockAddress, int toBlockAddress)
            .. **ST25 / SRT512** ..
            +byte[] getSystemBlock ()
        }
        +enum "ProductType" as ProductType <<green>> {
            MIFARE_ULTRALIGHT
            MIFARE_CLASSIC_1K
            MIFARE_CLASSIC_4K
            ST25_SRT512

            +getBlockCount (): int
            +getBlockSize (): int
            +hasSystemBlock (): boolean
            +hasWriteAcknowledgment (): boolean
            +hasAuthentication (): boolean
        }
    }

    +enum "MifareClassicKeyType" as MifareClassicKeyType <<green>> {
        KEY_A
        KEY_B
    }

    package "transaction" as transaction {
        +interface "<<<back:yellow>CardTransactionManager</back>>>\nStorageCardTransactionManager" as StorageCardTransactionManager <<blue>> {
            ' Standard Read/Write
            +StorageCardTransactionManager prepareReadBlock (int blockAddress)
            +StorageCardTransactionManager prepareReadBlocks (int fromBlockAddress, int toBlockAddress)
            +StorageCardTransactionManager prepareWriteBlocks (int fromBlockAddress, byte[] data)
            +<color:blue>StorageCardTransactionManager prepareWriteBlocks (int fromBlockAddress, byte[] data, int idCommand)
            .. **ST25 / SRT512** ..
            +StorageCardTransactionManager prepareSt25ReadSystemBlock ()
            +StorageCardTransactionManager prepareSt25WriteSystemBlock (byte[] data)
            +<color:blue>StorageCardTransactionManager prepareSt25WriteSystemBlock (byte[] data, int idCommand)
            .. **Mifare Classic** ..
            +StorageCardTransactionManager prepareMifareClassicAuthenticate (int blockAddress, MifareClassicKeyType mifareClassicKeyType, byte[] key)
            +StorageCardTransactionManager prepareMifareClassicAuthenticate (int blockAddress, MifareClassicKeyType mifareClassicKeyType, int keyNumber)
        }
    }

    +interface "StorageCardException" as StorageCardException <<green>> {
        +Integer getBlockAddress ()
        +<color:blue>Integer getIdCommand ()
    }
    +class "<<<back:yellow>ReaderCommunicationException</back>>>\nSCReaderCommunicationException" as SCReaderCommunicationException <<green>> implements StorageCardException {
    }
    +class "SCAuthenticationFailedException" as SCAuthenticationFailedException <<green>> implements StorageCardException {
    }
    +class "<<<back:yellow>CardCommunicationException</back>>>\nSCCardCommunicationException" as SCCardCommunicationException <<green>> implements StorageCardException {
    }
    +class "<<<back:yellow>InvalidCardResponseException</back>>>\nSCInvalidCardResponseException" as SCInvalidCardResponseException <<green>> implements StorageCardException {
    }
}

' Associations
StorageCardApiFactory ..> StorageCardSelectionExtension #C_LINK : create >
StorageCardApiFactory ..> StorageCardTransactionManager #C_LINK : create >
StorageCardApiFactory .right.> StorageCard #C_USE : use >
StorageCardApiFactory .right.> ProductType #C_USE : use >
StorageCard ..> ProductType #C_USE : provide >
StorageCardSelectionExtension ..> MifareClassicKeyType #C_USE : use >
StorageCardTransactionManager ..> MifareClassicKeyType #C_USE : use >

' == LAYOUT ==

StorageCardApiFactory -[hidden]- StorageCardSelectionExtension
StorageCardApiFactory -[hidden]- StorageCardTransactionManager
ProductType -[hidden]- StorageCardException
SCReaderCommunicationException -[hidden]down- SCAuthenticationFailedException

